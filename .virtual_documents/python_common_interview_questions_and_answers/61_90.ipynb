class People:
    def __init__(self,name):
        self.name=name
    def pr(self):
        print(f"[name] >>> {self.name}")

def pr(self):
    for x in range(10):
        print(f"[{x}-name] >>> {self.name}")

People.pr=pr
p=People("kom")
p.pr()
























































