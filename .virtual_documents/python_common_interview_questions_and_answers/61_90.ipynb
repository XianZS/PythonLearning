from abc import ABC, abstractmethod


# 抽象类 --- 定义了后续实现的规范
class Animal(ABC):
    @abstractmethod
    def speak(self):
        pass


class Cat(Animal):
    def speak(self):
        print("喵喵喵")


class Dog(Animal):
    def speak(self):
        print("汪汪汪")


cat = Cat()
dog = Dog()
cat.speak(), dog.speak()





class Stu:
    def __init__(self, name, age, address):
        # 体现出公有成员的访问规则
        self.name = name
        # 体现出受保护成员的访问规则
        self._age = age
        # 私有成员的访问规则
        self.__address = address


class Child(Stu):
    def __init__(self, name, age, address):
        super().__init__(name, age, address)

    def pr(self):
        print(f"[age] >>> {self._age}")

    def pr_address(self):
        print(f"[address] >>> {self.__address}")


