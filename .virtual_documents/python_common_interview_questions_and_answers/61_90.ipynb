class People:
    def __new__(cls, name, age):
        print(f"[new]>>>调用{name}={age}")
        return super().__new__(cls)

    def __init__(self, name, age):
        print(f"[init]>>>{name}={age}")
        self.name = name
        self.age = age


p1 = People("jom", 22)
p1.name,p1.age





