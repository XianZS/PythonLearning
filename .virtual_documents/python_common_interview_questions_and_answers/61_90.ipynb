class Dog:
    def speak(self):
        print("汪汪汪")


class Cat:
    def speak(self):
        print("喵喵喵")


# 同一的接口
def animal_speak(animal):
    animal.speak()


# 不同的调用方式，会产生不同的效果
animal_speak(Dog())
animal_speak(Cat())





